{
  "cleanUrls": true,
  "redirects": [
    {
      "source": "/playbook",
      "destination": "https://playbook.breakpointstrat.com/",
      "statusCode": 301
    },
    {
      "source": "/playbook.html",
      "destination": "https://playbook.breakpointstrat.com/",
      "statusCode": 301
    },
    {
      "source": "/:page(about|contact|legal|snapshot|data-deletion|llms.txt)",
      "has": [
        {
          "type": "host",
          "value": "playbook.breakpointstrat.com"
        }
      ],
      "destination": "https://www.breakpointstrat.com/:page",
      "statusCode": 301
    },
    {
      "source": "/privacy",
      "destination": "/legal#sms-privacy",
      "permanent": false
    },
    {
      "source": "/sms-terms",
      "destination": "/legal#sms-terms",
      "permanent": false
    },
    {
      "source": "/score",
      "destination": "/snapshot",
      "permanent": true
    },
    {
      "source": "/score/:id",
      "destination": "/snapshot",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/playbook-site/(.*)",
      "missing": [
        {
          "type": "host",
          "value": "playbook.breakpointstrat.com"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
